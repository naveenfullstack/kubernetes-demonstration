      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "937573769",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::125022369875:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/FA9E71FC7C77E150126FA55D098E80C2\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.us-east-1.amazonaws.com/id/FA9E71FC7C77E150126FA55D098E80C2:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.us-east-1.amazonaws.com/id/FA9E71FC7C77E150126FA55D098E80C2:sub\": \"system:serviceaccount:kube-system:aws-load-balancer-controller\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Principal\":{\"Federated\":\"arn:aws:iam::125022369875:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/FA9E71FC7C77E150126FA55D098E80C2\"},\"Condition\":{\"StringEquals\":{\"oidc.eks.us-east-1.amazonaws.com/id/FA9E71FC7C77E150126FA55D098E80C2:aud\":\"sts.amazonaws.com\",\"oidc.eks.us-east-1.amazonaws.com/id/FA9E71FC7C77E150126FA55D098E80C2:sub\":\"system:serviceaccount:kube-system:aws-load-balancer-controller\"}}}]}",
            "override_json": null,
            "override_policy_documents": null,
            "policy_id": null,
            "source_json": null,
            "source_policy_documents": null,
            "statement": [
              {
                "actions": [
                  "sts:AssumeRoleWithWebIdentity"
                ],
                "condition": [
                  {
                    "test": "StringEquals",
                    "values": [
                      "sts.amazonaws.com"
                    ],
                    "variable": "oidc.eks.us-east-1.amazonaws.com/id/FA9E71FC7C77E150126FA55D098E80C2:aud"
                  },
                  {
                    "test": "StringEquals",
